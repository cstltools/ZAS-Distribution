    private bool CheckValidation()
    {
        if (invoiceDateTextBox.Text == "")
        {
            ShowMessageBox("Please select invoice date !!");
            return false;
        }


        if (manufacDropDownList.SelectedValue == "")
        {
            ShowMessageBox("Please select a company !!");
            return false;
        }

        if (customerDropDownList.SelectedValue == "")
        {
            ShowMessageBox("Please select a customer !!");
            return false;
        }

        return true;
    }

    private string GenerateParameter()
    {
        string parameter = "";

        if (dcDropDownList.SelectedValue != "")
        {
            parameter = parameter + "AND tblInvoice.ComUnitId = '" + dcDropDownList.SelectedValue + "'";
        }

        if (customerDropDownList.SelectedValue != "")
        {
            parameter = parameter + "AND tblInvoice.CustomerMasterId = '" + customerDropDownList.SelectedValue + "'";
        }

        if (invoiceDateTextBox.Text != "" )
        {
            parameter = parameter + "AND tblInvoice.InvoiceDate = '" + Convert.ToDateTime(invoiceDateTextBox.Text.Trim()) + "'";
        }


        return parameter;
    }

    private void SetPaymentDivStatus()
    {
        if (orderGridView.Rows.Count > 0)
        {
            Payment.Visible = true;
            payTypeDDL.SelectedValue = 1.ToString(CultureInfo.InvariantCulture);
        }
        else
        {
            Payment.Visible = false;
        }
    }

