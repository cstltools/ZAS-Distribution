    protected void Button1_Click2(object sender, EventArgs e)
    {

        if (CheckValidation())
        {
            DataTable dt = aCustPaymentBll.LoadCustomerPaymentDueNew(GenerateParameter());

            if (dt.Rows.Count > 0)
