using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;
using Library.DAL.SInventory_DAL;

public partial class SInventory_UI_CustomerDueReport : System.Web.UI.Page
{
 
    CustomerDueReportDAL aDueReportDAL = new CustomerDueReportDAL();

    protected void Page_Load(object sender, EventArgs e)
    {
        if (!IsPostBack)
        {
            LoadDropdownList();
        }
    }

    private void LoadDropdownList()
    {
        aDueReportDAL.LoadGroupInfo(groupDropDownList);
        groupDropDownList.SelectedValue = 1.ToString();

        if (groupDropDownList.SelectedValue != "")
        {
            aDueReportDAL.LoadCompanyInfo(companyNameDropDownList, groupDropDownList.SelectedValue);
        }
        else
        {
            companyNameDropDownList.Items.Clear();
            dcDropDownList.Items.Clear();
        }
        aDueReportDAL.LoadCustomerDropdownList(customerDropDownList);
    }

    protected void companyNameDropDownList_SelectedIndexChanged(object sender, EventArgs e)
    {
        if (companyNameDropDownList.SelectedValue != "")
        {
            aDueReportDAL.LoadDcInfo(dcDropDownList, companyNameDropDownList.SelectedValue);
        }
    }
  
    protected void submitButton_Click(object sender, EventArgs e)
    {
        if (Validation())
        {
          
                PopUpCustomerDueReport();

        }
    }

  
    private bool Validation()
    {
        if (companyNameDropDownList.SelectedValue == "")
        {
            ShowMessageBox("Please Select a Company !!");
            return false;
        }

        return true;
    }

    private void PopUpCustomerDueReport()
    {
        Session["PRAM"] = "";
        Session["PRAM"] = GetPrameterList();
        const string url = "../SInventory_RPTVIEW/CustomerDueReportViewer.aspx";
        const string fullURL = "var Mleft = (screen.width/2)-(950/2);var Mtop = (screen.height/2)-(700/2);window.open( '" + url + "', null, 'height=700,width=950,status=yes,toolbar=no,addressbar=no, scrollbars=yes,menubar=no,location=no,top=\'+Mtop+\', left=\'+Mleft+\'' );";
        ScriptManager.RegisterStartupScript(this, typeof(string), "OPEN_WINDOW", fullURL, true);
    }

    private String GetPrameterList()
    {
        string parameter = "";

            if (companyNameDropDownList.SelectedValue != "")
            {
                parameter = parameter + " AND CI.CompanyId  = '" + companyNameDropDownList.SelectedValue + "'";
            }

            if (dcDropDownList.SelectedValue != "")
            {
                parameter = parameter + " AND INV.ComUnitId  = '" + dcDropDownList.SelectedValue + "'";
            }

            if (customerDropDownList.SelectedValue != "")
            {
                parameter = parameter + " AND INV.CustomerMasterId  = '" + customerDropDownList.SelectedValue + "'";
            }


        return parameter;
    }

    private void ShowMessageBox(string message)
    {
        message = message.Replace("'", "\'");
        string sScript = String.Format("alert('{0}');", message);
        ScriptManager.RegisterStartupScript(this, this.GetType(), "alert", sScript, true);
    }

    protected void clearButton_OnClick(object sender, EventArgs e)
    {
        Clear();
    }

    private void Clear()
    {
        //groupDropDownList.SelectedValue = "";
        companyNameDropDownList.SelectedValue = "";
        dcDropDownList.Items.Clear();
        customerDropDownList.SelectedValue = "";

    }
}