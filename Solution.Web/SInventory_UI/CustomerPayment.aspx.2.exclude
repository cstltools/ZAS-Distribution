                        </td>
                        <td width="20%" class="TDRight">
                            <asp:DropDownList ID="manufacDropDownList" runat="server" AutoPostBack="True" CssClass="DropDown" OnSelectedIndexChanged="manufacDropDownList_OnSelectedIndexChanged">
