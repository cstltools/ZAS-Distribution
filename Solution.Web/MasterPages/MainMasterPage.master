    <%-- ReSharper disable once InvalidValue --%>
    <style type="text/css">
        
        
        /*form progress bar*/
       .divWaiting {
            background-color: #999;
            position: fixed;
            left: 0px;
            top: 0px;
            z-index: 2147483647;
            width: 100%;
            height: 100%;
            opacity: 0.5;
            overflow: hidden;
            text-align: center;
        }


         .position-set {
             margin: 300px auto;
         }
        
        .button-padding-right
        {
            margin-right: 5px;
        }
        
        .TableHeading {
            padding: 10px;
        }
        
         .ui-datepicker
         {
             font-size: 8pt !important;
         }
        .radioButtonList label
        {
            display:inline;
        }
        
        
        
        <%--Custome CSS--%>
        
        * {
            margin: 0;
            padding: 0;
        }
        
        #custom-container {

            width: 98%;
            background: #fff;
            margin: 0 auto;
            padding: 0;
            box-shadow: 0px 0px 4px 0px rgba(0, 0, 0, 0.2);
            
        }
        
        #navigation { 
            width: 101% !important;
            background-color: #900C3F !important;
            z-index: 1;
        }
        
        .container {
            width: 100%;
        }
        
        #logout {
            margin-right: 15px;
        }
        
        #logo {
            margin-left: 15px;
        }
        
        #footer-bottom {
            width: 98%;
            margin: 0 auto;
        }
        
        
        .TableWorkArea {
            width: 96%;
            margin: 35px auto;
            padding: 15px;
        }
        
        
        
        * {
            margin: 0;
            padding: 0;
        }
        
        ul, li {
            list-style-type: none;
        }
 
        .navigation-bar {
            width: 100%;
            height: 100%;
            padding: 5px;
            background-color: #2980B9;
            z-index: 1;
        }

        .menu-bar{
            width: 10%;
            float: left;
        }
        .menu-bar > .icon {
            display:none;
        }
        .menu-bar > .icon > .icon-link {
            text-decoration:none;
            color:#fff;
            display:block;
            padding: 10px;
        }
        .topnav {
            width: 70%;
            float: left;
        }
        .topnav:after ,.icon-bar:after, .menu-bar:after{
            content: '';
            display:block;
            clear:both;
        }
        .topnav > .topnav-item {
            display:inline-block;
            position:relative;
     
        }

        .topnav > .topnav-item:not(:last-child) {
            border-right: 1px solid #eee;
            z-index: 1;
        }

        .icon-bar > .icon {
            float: left;
            display:none;
        }
        .icon-bar > .icon > .icon-link {
            color:#fff;
            display:block;
            padding: 8px 12px;
        }
        .topnav > .topnav-item > .topnav-link {
            color:#fff;
            text-decoration:none;
            display:block;
            padding: 10px 16px;
        }
        .topnav > .topnav-item:hover > .firstnav {
            display:block;
        }
        .topnav > .topnav-item > .firstnav {
            display:none;
            text-align:center;
            position:absolute;
            top: 105%;
            background-color: #fff;
            border: 1px solid #A4B0BE;
            z-index: 1;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item {
            display: block;
            position:relative;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item:hover > .firstnav-link {
            background-color:#B2bEC3;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item:not(:last-child){
            border-bottom: 1px solid #555;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item:hover > .secondnav {
            display:block;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .firstnav-link {
            text-decoration:none;
            min-width: 200px;
            padding: 10px 15px;
            display:block;
            color: #3F3542;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav {
            display: none;
            text-align: center;
            position: absolute;
            top: 0;
            left: 100%;
            background-color: #fff;
            border: 1px solid #A4B0BE;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item {
            display: block;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item:hover > .secondnav-link{
            background-color:#B2bEC3;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item:not(:last-child){
            border-bottom: 1px solid #555;
        }
        .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item > .secondnav-link {
            text-decoration:none;
            min-width: 200px;
            padding: 10px 15px;
            display:block;
            color: #3F3542;
        }

        @media screen and (max-width: 992px) 
        {
   
            .menu {
                position: relative;
            }
    
            .topnav {
                width: 400px;
                -webkit-transform: translateX(-60px);
                -moz-transform: translateX(-60px);
                -ms-transform: translateX(-60px);
                -o-transform: translateX(-60px);
                transform: translateX(-60px);
                z-index: 1;
            }

            .topnav > .topnav-item {
                display: none;
            }
    
            .icon-bar {
                margin-left: 20px;
            }
    
            .icon-bar > .icon {
                float:left;
                display:block;
            }
    
        }
        @media screen and (max-width: 992px) {
     
     
            .TableWorkArea {
                width: 96%;
                margin: 65px auto;
                padding: 15px;
            }
            
             .TableWorkArea222 {
                width: 70%;
                margin: 36px auto;
                padding: 10px;
            }
     
      
            .page-content {
                padding-top: 10px;
            }
     
            .responsive 
            {
                width: 400px;
                width: 50%;
                -webkit-transform: translateX(0px);
                -moz-transform: translateX(0px);
                -ms-transform: translateX(0px);
                -o-transform: translateX(0px);
                transform: translateX(0px);
        
                -webkit-transition: transform .5s;
                -moz-transition: transform .5s;
                -ms-transition: transform .5s;
                -o-transition: transform .5s;
                transition: transform .5s;
                z-index: 1;
            }
           
            .responsive > .topnav-item 
            {
                width: 100%;
                float: left;
                display:block;
            }
     
            .responsive > .topnav-item {
                top:100%;
                text-align:left;
            }
            .responsive > .topnav-item:hover > .firstnav {
                position:static;
                display: block;
                text-align:left;
                padding-left: 25px;
                background-color: #5ABCE9;
                border: none;
            }
            .responsive > .topnav-item > .firstnav > .firstnav-item:hover > .secondnav {
                position:static;
                display: block;
                padding-left: 2px;
                background-color: #2980B9;
                border: none;
            }
    
            .topnav > .topnav-item > .firstnav > .firstnav-item:not(:last-child){
                border-bottom: none;
            }
    
    
            .topnav > .topnav-item > .firstnav > .firstnav-item > .firstnav-link {
                color: #fff;
            }
     
            .topnav > .topnav-item > .firstnav > .firstnav-item:hover > .firstnav-link 
            {
                font-size: 15px;
                background-color: #5ABCE9;
            }
    
            .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item:not(:last-child){
                border-bottom: none;
            }
     
            .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item:hover > .secondnav-link
            {
                font-size:15px;
                background-color: #5ABCE9;
            }
     
            .topnav > .topnav-item > .firstnav > .firstnav-item > .secondnav > .secondnav-item > .secondnav-link {
                color: #fff;
            }
     
            .topnav > .topnav-item > .firstnav > .firstnav-item:hover > .secondnav {
                background-color: #5ABCE9;
            }
        }
        
        .button-margin-right {
            margin-right: 5px;
        }
        
        
        
        
        
        .clearButton 
        {
            padding: 0.2em;
            margin-left: 10px;
            background-color: #079992;
        }
        
        .star-mark {
            color: red;
        }
        
        
        
        
        
        .btn-group .button {
              background-color: #0090C0; /* Green background */
              border: 1px solid #0090C0; /* Green border */
              color: white; /* White text */
              padding: 6px 14px; /* Some padding */
              cursor: pointer; /* Pointer/hand icon */
              float: left; /* Float the buttons side by side */
        }

        .btn-group .button:not(:last-child) {
               border-right: 1px solid #fff; /* Prevent double borders */
        }

        /* Clear floats (clearfix hack) */
        .btn-group:after {
            content: "";
            clear: both;
            display: table;
        }

        /* Add a background color on hover */
        .btn-group .button:hover {
            background-color: #0090C0;
         }
         
         
         /*.divWaiting
        {
            position: absolute;
            z-index: 2147483647 !important;
            opacity: 0.5;
            overflow: hidden;
            text-align: center;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            padding-top: 0px;
        }*/
           
    </style>
    <script type="text/javascript">

        $(document).ready(function () {

            $(".icon-link").click(function () {

                $(".topnav").toggleClass("responsive");

            });

        });
        
    </script>
</head>
